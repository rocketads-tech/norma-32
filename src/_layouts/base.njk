<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} | Норма 32</title>
    <meta name="description" content="{{ description or 'Стоматологическая клиника Норма 32' }}">

    {# Умное подключение CSS #}
    {% set mainCss = css or "style.css" %}
    {% set cssPath = '/css/' + mainCss %}
<link rel="stylesheet" href="{{ cssPath | url }}">
    
    <link rel="stylesheet" href="{{ '/css/vendor/swiper-bundle.min.css' | url }}">
</head>
<body class="{{ bodyClass or '' }}">
    {% include "header.njk" %}
    
    <main>
        {{ content | safe }}
    </main>
    
    {% include "footer.njk" %}
    {% include "modal.njk" %}
    
    <script src="{{ '/js/script.js' | url }}"></script>
    <script src="{{ '/js/vendor/swiper-bundle.min.js' | url }}"></script>
    
</body>
</html>