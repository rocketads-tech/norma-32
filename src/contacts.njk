---
layout: default.njk
bodyClass: page-internal
title: Контакты - Стоматология Норма 32 в Мариуполе
description: Адрес, телефон, режим работы и форма записи на приём в стоматологическую клинику Норма 32 в Мариуполе.
css: contacts-page.css
---

{% from "macros/breadcrumbs.njk" import breadcrumbs %}
{% from "macros/page-header.njk" import pageHeader %}
{% from "macros/faq-accordion.njk" import faqAccordion %}
{% from "macros/cta-block.njk" import ctaBlock %}

{{ breadcrumbs([
{ title: "Главная", url: "/" },
{ title: "Контакты" }
]) }}

{# Hero-заголовок #}
{{ pageHeader(contacts.header.title, contacts.header.subtitle, contacts.header.highlight) }}

{# Основной блок: Информация + Форма + Карта #}
<section class="contacts-main-section">
  <div class="container">
    <div class="contacts-grid">
            {# Левая колонка: Информация и Карта #}
      <div class="contacts-info-column">
        
        {# Карта с плашкой адреса #}
        <div class="contacts-map-card">
          <div class="map-wrapper">
            <iframe src="https://yandex.ru/map-widget/v1/?from=api-maps&ll=37.522542%2C47.091074&mode=whatshere&origin=jsapi_2_1_79&utm_source=jsapi&whatshere%5Bpoint%5D=37.522792%2C47.091116&whatshere%5Bzoom%5D=17&z=17.4" width="100%" height="100%" frameborder="0" allowfullscreen="true" style="border:none;"></iframe>
            <div class="map-address-badge">
              <div class="badge-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div class="badge-content">
                <span class="badge-label">Адрес клиники</span>
                <span class="badge-value">{{ site.address.fullAddress }}</span>
              </div>
            </div>
          </div>
        </div>

                {# Контактные карточки (данные из site.json) #}
        <div class="contacts-cards-list">
          
          {# Режим работы #}
          <div class="contact-card">
            <div class="contact-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div class="contact-card-content">
              <span class="contact-card-label">Режим работы</span>
              <span class="contact-card-value">{{ site.workHours.short }}</span>
            </div>
          </div>

          {# Телефон #}
          <div class="contact-card">
            <div class="contact-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <div class="contact-card-content">
              <span class="contact-card-label">Телефон</span>
              <a href="{{ site.phoneLink }}" class="contact-card-value">{{ site.phone }}</a>
            </div>
          </div>

          {# Email #}
          <div class="contact-card">
            <div class="contact-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <div class="contact-card-content">
              <span class="contact-card-label">Email</span>
              <a href="mailto:{{ site.email }}" class="contact-card-value">{{ site.email }}</a>
            </div>
          </div>

					{# Соцсети (данные из site.json) #}
					<div class="contacts-socials-card">
						<div class="contact-card-icon">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
							</svg>
						</div>
						<div class="contact-card-content">
							<span class="contact-card-label">Мы в мессенджерах</span>
							<div class="socials-links">
								{% if site.social.telegram %}
									<a href="{{ site.social.telegram }}" class="social-link-btn" target="_blank" rel="noopener">
										<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
													<path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM16.64 8.8C16.49 10.38 15.84 14.22 15.51 15.98C15.37 16.73 15.09 16.98 14.83 17.01C14.25 17.06 13.81 16.62 13.25 16.25C12.37 15.67 11.87 15.31 11.02 14.75C10.03 14.1 10.67 13.74 11.24 13.15C11.39 13 14.06 10.57 14.11 10.36C14.12 10.33 14.12 10.25 14.07 10.21C14.02 10.17 13.95 10.18 13.89 10.19C13.81 10.21 12.51 11.07 9.98 12.78C9.61 13.03 9.28 13.15 8.98 13.14C8.65 13.13 8.02 12.95 7.55 12.8C6.97 12.61 6.51 12.51 6.55 12.19C6.57 12.03 6.79 11.87 7.22 11.7C9.87 10.54 11.62 9.79 12.47 9.44C14.92 8.42 15.43 8.24 15.76 8.24C15.83 8.24 16.01 8.26 16.12 8.35C16.22 8.43 16.24 8.54 16.25 8.62C16.26 8.69 16.27 8.87 16.64 8.8Z" fill="currentColor"/>
											</svg>
										<span>Telegram</span>
									</a>
								{% endif %}
								{% if site.social.vk %}
									<a href="{{ site.social.vk }}" class="social-link-btn" target="_blank" rel="noopener">
										<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
													<path d="M13.162 18.994c.609 0 .858-.406.851-.915-.031-1.918.714-2.949 2.059-1.603 1.488 1.488 1.796 2.518 3.613 2.518h3.2c.816 0 1.156-.406.928-1.21-.241-.853-1.109-1.748-2.253-2.982-.621-.682-1.551-1.427-1.551-1.949 0-.522.454-.682 1.551-1.893 1.097-1.21 1.895-2.332 2.16-3.272.265-.94-.132-1.445-1.056-1.445h-3.2c-.816 0-1.197.431-1.406.907-.682 1.551-1.828 3.272-2.283 3.272-.229 0-.644-.229-.644-1.21V7.38c0-.816-.229-1.197-.853-1.197H9.83c-.506 0-.816.373-.816.728 0 .762 1.147.94 1.263 3.107v4.682c0 1.014-.183 1.21-.581 1.21-1.097 0-3.769-4.025-5.35-8.634-.313-.88-.626-1.234-1.445-1.234H.7c-.915 0-1.097.431-1.097.907 0 .842 1.082 5.018 5.042 10.524 2.644 3.782 6.358 5.81 9.772 5.81h.745z" fill="currentColor"/>
											</svg>
										<span>ВКонтакте</span>
									</a>
								{% endif %}
								{% if site.social.max %}
									<a href="{{ site.social.max }}" class="social-link-btn" target="_blank" rel="noopener">
										<svg width="24" height="24" viewBox="0 0 720 720" fill="none" xmlns="http://www.w3.org/2000/svg" class="social-icon">
													<path d="M350.4 9.6C141.8 20.5 4.1 184.1 12.8 390.4c3.8 90.3 40.1 168 48.7 253.7 2.2 22.2-4.2 49.6 21.4 59.3 31.5 11.9 79.8-8.1 106.2-26.4 9-6.1 17.6-13.2 24.2-22 27.3 18.1 53.2 35.6 85.7 43.4 143.1 34.3 299.9-44.2 369.6-170.3C799.6 291.2 622.5-4.6 350.4 9.6ZM269.4 504c-11.3 8.8-22.2 20.8-34.7 27.7-18.1 9.7-23.7-.4-30.5-16.4-21.4-50.9-24-137.6-11.5-190.9 16.8-72.5 72.9-136.3 150-143.1 78-6.9 150.4 32.7 183.1 104.2 72.4 159.1-112.9 316.2-256.4 218.6Z" fill="currentColor"/>
											</svg>
										<span>MAX</span>
									</a>
								{% endif %}
							</div>
						</div>
					</div>
				</div>
      </div>
      {# Правая колонка: Форма записи #}
      <div class="contacts-form-column">
        <div class="contacts-form-wrapper">
          <h2 class="contacts-form-title">{{ contacts.form.title }}</h2>
          <p class="contacts-form-subtitle">{{ contacts.form.subtitle }}</p>
          
          <form class="contact-form" action="#" method="POST">
            {% for field in contacts.form.fields %}
              <div class="form-group">
                <label for="{{ field.name }}" class="form-label">
                  {{ field.label }} {% if field.required %}<span class="required">*</span>{% endif %}
                </label>
                
                {% if field.type == 'textarea' %}
                  <textarea id="{{ field.name }}" name="{{ field.name }}" class="form-input" rows="4" placeholder="{{ field.placeholder }}" {% if field.required %}required{% endif %}></textarea>
                {% else %}
                  <input type="{{ field.type }}" id="{{ field.name }}" name="{{ field.name }}" class="form-input" placeholder="{{ field.placeholder }}" {% if field.required %}required{% endif %}>
                {% endif %}
              </div>
            {% endfor %}
            
            <div class="form-consent">
              <input type="checkbox" id="consent" name="consent" required>
              <label for="consent">Я согласен на обработку <a href="#">персональных данных</a></label>
            </div>
            
            <button type="submit" class="btn btn-primary btn-full">{{ contacts.form.button }}</button>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

{# FAQ #}
{{ faqAccordion(contacts.faq) }}

{# CTA #}
{{ ctaBlock(contacts.cta) }}