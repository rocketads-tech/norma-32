---
layout: default.njk
bodyClass: page-internal
title: Контакты - Стоматология Норма 32 в Мариуполе
description: Адрес, телефон, режим работы и форма записи на приём в стоматологическую клинику Норма 32 в Мариуполе.
css: contacts-page.css
---

{% from "macros/breadcrumbs.njk" import breadcrumbs %}
{% from "macros/page-header.njk" import pageHeader %}
{% from "macros/faq-accordion.njk" import faqAccordion %}
{% from "macros/cta-block.njk" import ctaBlock %}

{{ breadcrumbs([
{ title: "Главная", url: "/" },
{ title: "Контакты" }
]) }}

{# Hero-заголовок #}
{{ pageHeader(contacts.header.title, contacts.header.subtitle, contacts.header.highlight) }}

{# Основной блок: Информация + Форма + Карта #}
<section class="contacts-main-section">
  <div class="container">
    <div class="contacts-grid">
            {# Левая колонка: Информация и Карта #}
      <div class="contacts-info-column">
        
        {# Карта с плашкой адреса #}
        <div class="contacts-map-card" data-animate="fade-left" data-delay="100">
          <div class="map-wrapper">
            <iframe src="https://yandex.ru/map-widget/v1/?from=api-maps&ll=37.522542%2C47.091074&mode=whatshere&origin=jsapi_2_1_79&utm_source=jsapi&whatshere%5Bpoint%5D=37.522792%2C47.091116&whatshere%5Bzoom%5D=17&z=17.4" width="100%" height="100%" frameborder="0" allowfullscreen="true" style="border:none;"></iframe>
            <div class="map-address-badge">
              <div class="badge-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div class="badge-content">
                <span class="badge-label">Адрес клиники</span>
                <span class="badge-value">{{ site.address.fullAddress }}</span>
              </div>
            </div>
          </div>
        </div>

                {# Контактные карточки (данные из site.json) #}
        <div class="contacts-cards-list">
          
          {# Режим работы #}
          <div class="contact-card" data-animate="fade-left" data-delay="200">
            <div class="contact-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div class="contact-card-content">
              <span class="contact-card-label">Режим работы</span>
              <span class="contact-card-value">{{ site.workHours.short }}</span>
            </div>
          </div>

          {# Телефон #}
          <div class="contact-card" data-animate="fade-left" data-delay="300">
            <div class="contact-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <div class="contact-card-content">
              <span class="contact-card-label">Телефон</span>
              <a href="{{ site.phoneLink }}" class="contact-card-value">{{ site.phone }}</a>
            </div>
          </div>

          {# Email #}
          <div class="contact-card" data-animate="fade-left" data-delay="200">
            <div class="contact-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <div class="contact-card-content">
              <span class="contact-card-label">Email</span>
              <a href="mailto:{{ site.email }}" class="contact-card-value">{{ site.email }}</a>
            </div>
          </div>

					{# Соцсети (данные из site.json) #}
					<div class="contacts-socials-card" data-animate="fade-left" data-delay="100">
						<div class="contact-card-icon">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
							</svg>
						</div>
						<div class="contact-card-content">
							<span class="contact-card-label">Мы в мессенджерах</span>
							<div class="socials-links">
								{% if site.social.telegram %}
									<a href="{{ site.social.telegram }}" class="social-link-btn" target="_blank" rel="noopener">
