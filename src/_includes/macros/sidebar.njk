{% macro pageSidebar(sections, siteData) %}
  <!-- Блок TOC (только десктоп) -->
  <div class="sidebar-toc desktop-only">
    <h3 class="sidebar-toc-title">Содержание</h3>
    <nav class="sidebar-toc-list">
      {% for section in sections %}
        <a href="#{{ section.id }}" class="sidebar-toc-link">
          {{ section.title }}
        </a>
      {% endfor %}
    </nav>
  </div>
  
  <!-- Блок контактов -->
  <div class="sidebar-contacts">
    <h3 class="sidebar-contacts-title">Контакты</h3>
    
    <div class="sidebar-contact-item">
      <svg class="contact-icon" width="20" height="20" viewBox="0 0 24 24" fill="none">
        <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z" stroke="currentColor" stroke-width="2"/>
      </svg>
      <a href="{{ siteData.phoneLink }}" class="contact-link">{{ siteData.phone }}</a>
    </div>
    
    <div class="sidebar-contact-item">
      <svg class="contact-icon" width="20" height="20" viewBox="0 0 24 24" fill="none">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="2"/>
        <polyline points="22,6 12,13 2,6" stroke="currentColor" stroke-width="2"/>
      </svg>
      <a href="mailto:{{ siteData.email }}" class="contact-link">{{ siteData.email }}</a>
    </div>
    
    <div class="sidebar-contact-item">
      <svg class="contact-icon" width="20" height="20" viewBox="0 0 24 24" fill="none">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" stroke="currentColor" stroke-width="2"/>
        <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2"/>
      </svg>
      <span class="contact-text">{{ siteData.address.fullAddress }}</span>
    </div>
    
    <div class="sidebar-contact-item">
      <svg class="contact-icon" width="20" height="20" viewBox="0 0 24 24" fill="none">
        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
        <polyline points="12 6 12 12 16 14" stroke="currentColor" stroke-width="2"/>
      </svg>
      <span class="contact-text">{{ siteData.workHours.short }}</span>
    </div>
    
    <div class="sidebar-contact-item">
      <button class="sidebar-cta-button js-open-modal">Записаться</button>
    </div>
    
  </div>
{% endmacro %}