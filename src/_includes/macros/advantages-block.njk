{% macro advantagesBlock(data) %}
<section class="advantages-block {{ 'reverse' if data.reverse }}">
  <div class="container">
    <div class="advantages-content">
      <!-- Изображение -->
      <div class="advantages-image">
        <div class="advantages-image-wrapper">
          {% if data.showBg | default(true) %}
          <div class="advantages-image-bg"></div>
          {% endif %}
          <img src="{{ data.image | url }}" alt="{{ data.imageAlt | default('') }}" class="advantages-img" data-animate="scale" data-delay="200">
        </div>
      </div>
      
      <!-- Текст + преимущества -->
      <div class="advantages-text">
        <h2 class="advantages-title" data-animate="fade-up" data-delay="100">
          {{ data.title | replace(data.highlight, '<span class="highlight">' + data.highlight + '</span>') | safe }}
        </h2>
        
        {% if data.description %}
        <p class="advantages-description" data-animate="fade-up" data-delay="300">{{ data.description }}</p>
        {% endif %}
        
        {% if data.advantages %}
        <ul class="advantages-list" data-animate="fade-up" data-delay="400">
          {% for item in data.advantages %}
          <li class="advantages-item">
            <svg class="advantages-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M16.6666 5L7.49992 14.1667L3.33325 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>{{ item }}</span>
          </li>
          {% endfor %}
        </ul>
        {% endif %}
        
        <button class="btn btn-primary js-open-modal" data-animate="fade-right" data-delay="600">
          Записаться на прием
        </button>
      </div>
    </div>
  </div>
</section>
{% endmacro %}