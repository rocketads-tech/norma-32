{# 
  МАКРОС АККОРДЕОНА
  Параметры:
  - items: массив объектов { title, content, id (опционально) }
  - group: имя группы (для aria, опционально)
  - mode: 'default' | 'menu' (разные стили для FAQ и меню)
#}

{% macro accordion(items, group='accordion', mode='default') %}
<div class="accordion" role="region" aria-label="{{ group }}">
  {% for item in items %}
  <div class="accordion-item">
    <button 
      class="accordion-trigger" 
      aria-expanded="false" 
      aria-controls="{{ group }}-content-{{ loop.index }}"
      id="{{ group }}-trigger-{{ loop.index }}"
    >
      <span class="accordion-title">{{ item.title }}</span>
      <svg class="accordion-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <div 
      class="accordion-content" 
      id="{{ group }}-content-{{ loop.index }}"
      role="region"
      aria-labelledby="{{ group }}-trigger-{{ loop.index }}"
    >
      <div class="accordion-inner">
        {% if mode == 'menu' %}
          {# Для меню: content — это массив ссылок #}
          {% for link in item.content %}
            <a href="{{ link.url }}">{{ link.label }}</a>
          {% endfor %}
        {% else %}
          {# Для FAQ и других: content — это HTML-строка #}
          {{ item.content | safe }}
        {% endif %}
      </div>
    </div>
  </div>
  {% endfor %}
</div>
{% endmacro %}