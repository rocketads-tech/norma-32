<section class="hero">
  <div class="container">
    <div class="hero-content">
      <!-- Левая колонка -->
      <div class="hero-text">
        <h1 class="hero-title">Норма 32 — стоматология  <span class="highlight">с гарантией!</span></h1>
        
        <p class="hero-description">
          В клинике «Норма 32» мы используем современное оборудование и сертифицированные материалы, чтобы лечение проходило бережно и без боли. Запишитесь на приём, и мы позаботимся о здоровье вашей улыбки.
        </p>
        
        <div class="hero-cta">
          <!-- Основная кнопка -->
          <button class="btn btn-primary js-open-modal">Записаться</button>
          
          <!-- Ссылка с телефоном -->
          <a href="tel:{{ site.phoneLink }}" class="hero-phone-link">
            <div class="hero-phone-icon">
              <img src="{{'/images/icons/calling.svg' | url}}" alt="" aria-hidden="true">
            </div>
            <div class="hero-phone-content">
              <span class="hero-phone-title">{{ site.name }}</span>
              <span class="hero-phone-number">{{ site.phone }}</span>
            </div>
          </a>
        </div>
        
        <!-- Карточка отзыва -->
        <div class="hero-review">
          <div class="review-content">
            <div class="review-header">
							<img src="{{'/images/avatar.png' | url}}" alt="Игорь Иванович" class="review-avatar">
              <span class="review-name">Игорь Иванович</span>
            </div>
						<div class="review-body">
							<p class="review-text">
								"Очень качественная стоматология. Рекомендую от всей души!"
							</p>
						</div>
          </div>
        </div>
      </div>
      
      <!-- Правая колонка -->
      <div class="hero-image">
        <div class="hero-image-wrapper">
          <img src="{{'/images/hero-shape.png' | url}}" alt="" class="hero-shape" aria-hidden="true">
          <img src="{{'/images/hero-2.png' | url}}" alt="Стоматолог" class="hero-photo">
        </div>
      </div>
    </div>
  </div>
</section>